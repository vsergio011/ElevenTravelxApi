PORT=8080
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_ISSUER=https://[YOUR-PROJECT-REF].supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Para proyectos con JWT asimetrico (ES256/RS256), SUPABASE_JWT_SECRET puede quedar vacio
# y se validara usando JWKS desde SUPABASE_JWT_ISSUER/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,https://app.eleventravel.com
MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token
# Cloudflare R2 (solo backend). Si faltan, los endpoints de imagenes responden 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BUCKET=app-public-prod
R2_PRIVATE_BUCKET=app-private-prod
R2_PUBLIC_DOMAIN=https://media.tudominio.com
